{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computecloud.dev/schema/control/v1alpha1/control.schema.json",
  "title": "computecloud Agent Control Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "session_id", "job_id", "task_id", "attempt_id", "generation", "runtime", "state", "capabilities"],
  "properties": {
    "protocol_version": {"const": "control.v1alpha1"},
    "session_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "worker_id": {"type": "string"},
    "runtime": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string"},
    "runtime_session_ref": {"type": "string"},
    "state": {
      "enum": ["CREATED", "STARTING", "RUNNING", "WAITING_INPUT", "WAITING_APPROVAL", "INTERRUPTING", "COMPLETED", "FAILED", "CANCELED", "UNVERIFIABLE"]
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "capabilities.schema.json#/$defs/capability"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
