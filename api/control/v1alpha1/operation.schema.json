{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computecloud.dev/schema/control/v1alpha1/operation.schema.json",
  "title": "computecloud Agent Control Operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "operation_id",
    "operation_type",
    "resource_type",
    "resource_id",
    "job_id",
    "state",
    "created_at"
  ],
  "properties": {
    "protocol_version": {
      "const": "control.v1alpha1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_type": {
      "enum": [
        "cancel",
        "input",
        "interrupt",
        "approval",
        "resume"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string"
    },
    "task_id": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "ACCEPTED",
        "REJECTED",
        "COMPLETED"
      ]
    },
    "existing": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "message": {
      "type": "string"
    },
    "resource_type": {
      "enum": [
        "job",
        "session",
        "approval"
      ]
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "resource_version": {
      "type": "integer",
      "minimum": 0
    }
  }
}
