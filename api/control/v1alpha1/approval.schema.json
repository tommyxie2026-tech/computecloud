{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computecloud.dev/schema/control/v1alpha1/approval.schema.json",
  "title": "computecloud Agent Approval Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "approval_id", "job_id", "task_id", "attempt_id", "generation", "session_id", "tool", "action", "risk_class", "request_version", "requested_at", "state"],
  "properties": {
    "protocol_version": {"const": "control.v1alpha1"},
    "approval_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "generation": {"type": "integer", "minimum": 1},
    "session_id": {"type": "string", "minLength": 1},
    "tool": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "risk_class": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
    "arguments_summary": {"type": "string"},
    "policy_context": {"type": "object"},
    "request_version": {"type": "integer", "minimum": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["PENDING", "ACCEPTED", "REJECTED", "EXPIRED", "SUPERSEDED"]}
  }
}
