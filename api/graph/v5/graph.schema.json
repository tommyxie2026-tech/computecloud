{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "iu-graph-v5"
    },
    "project_id": {
      "type": "string"
    },
    "workspace": {
      "$ref": "#/$defs/workspace"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "maxItems": 128
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/span"
      },
      "maxItems": 128
    },
    "operators": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operator"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 128
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/output"
      },
      "maxItems": 32,
      "minItems": 1
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "profile",
        "version"
      ]
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "additionalProperties": {
        "type": [
          "object",
          "boolean"
        ]
      }
    },
    "imports": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "node_ids"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "node_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            }
          }
        }
      }
    },
    "reuse": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "grant_id",
          "node_id"
        ],
        "properties": {
          "grant_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "node_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "goal_source_id",
        "goal_spec_sha256",
        "profile",
        "profile_version",
        "scope",
        "obligations",
        "checks",
        "sha256"
      ],
      "properties": {
        "version": {
          "const": "iu-coverage-v1"
        },
        "goal_source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "goal_spec_sha256": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "profile_version": {
          "type": "string",
          "maxLength": 256
        },
        "scope": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_obligation"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coverage_check"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "sha256": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "version",
    "project_id",
    "workspace",
    "sources",
    "operators",
    "nodes",
    "edges",
    "outputs",
    "limits",
    "evaluator",
    "schemas",
    "coverage"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:computecloud:iu-graph-v5",
  "$defs": {
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository_ref": {
          "type": "string"
        },
        "base_commit": {
          "type": "string",
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        }
      },
      "required": [
        "repository_ref",
        "base_commit"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "text": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "role": {
          "enum": [
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "message_index": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "text"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "start",
        "end",
        "sha256"
      ]
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "schema"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string"
        },
        "runtime_profile": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "credential_ref": {
          "type": "string"
        },
        "policy_ref": {
          "type": "string"
        },
        "acceptance_profile": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "replay_safe": {
          "type": "boolean"
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 16
        }
      },
      "required": [
        "runtime_profile",
        "model",
        "credential_ref",
        "policy_ref",
        "acceptance_profile"
      ]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "version": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "agent",
            "command",
            "join"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "maxItems": 32
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "command_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "id",
        "version",
        "kind",
        "outputs"
      ]
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "operator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "instructions": {
          "type": "string"
        },
        "spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "maxItems": 128
        },
        "scope_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 64
        },
        "join_policy": {
          "enum": [
            "all_success",
            "selected_success"
          ]
        },
        "parameters": {},
        "replay_profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "rules": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "context_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version"
          ],
          "properties": {
            "version": {
              "const": "iu-context-policy-v1"
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "max_input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "required_evidence": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "$ref": "#/$defs/span"
              }
            }
          }
        }
      },
      "required": [
        "id",
        "operator"
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "from_node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "from_port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "to_node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "to_port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "type": {
          "enum": [
            "artifact",
            "memory",
            "control"
          ]
        },
        "when": {
          "enum": [
            "PASS",
            "FAIL",
            "UNKNOWN"
          ]
        }
      },
      "required": [
        "from_node",
        "to_node",
        "type"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "port": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      },
      "required": [
        "node",
        "port"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_attempts_per_task": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_replans": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max_cost_units": {
          "type": "integer",
          "minimum": 1
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "parallelism",
        "timeout_seconds",
        "max_attempts_per_task"
      ]
    },
    "coverage_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "sources",
        "node_ids",
        "check_id"
      ],
      "properties": {
        "constraint_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "minItems": 1,
          "maxItems": 32
        },
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        }
      }
    },
    "coverage_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "outputs"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,63}$"
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/output"
          },
          "minItems": 1,
          "maxItems": 32
        }
      }
    }
  }
}
