{
  "name": "@computecloud/control",
  "version": "0.4.6.1",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --output-dir dist",
    "check": "npm run typecheck && npm run export:web",
    "test:web:api": "node scripts/web-api-test.mjs && node scripts/web-snapshot-test.mjs && node scripts/web-read-recovery-test.mjs",
    "test:web": "node scripts/web-browser-e2e.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "expo": "~57.0.0",
    "expo-secure-store": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.2"
  }
}
