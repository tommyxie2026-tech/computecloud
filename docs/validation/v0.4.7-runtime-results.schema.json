{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://computecloud.invalid/schemas/v0.4.7-runtime-results.schema.json",
  "title": "computecloud v0.4.7 real Runtime acceptance report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "candidate", "execution", "runtimes", "cases"],
  "properties": {
    "schema_version": {"const": "computecloud.v0.4.7.runtime-acceptance.v1"},
    "status": {"const": "PASSED"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha", "built_from_sha"],
      "properties": {
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "built_from_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "real_model_calls", "authorized_account", "service_endpoint_scheme", "started_at", "completed_at"],
      "properties": {
        "environment": {"const": "real"},
        "real_model_calls": {"const": true},
        "authorized_account": {"const": true},
        "service_endpoint_scheme": {"const": "unix"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "runtimes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/runtime"}
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "version", "image_digest", "deployed_image_digest", "real_provider"],
      "properties": {
        "profile": {"enum": ["codex_http", "claude_http"]},
        "version": {"enum": ["0.160.1", "2.1.292"]},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "deployed_image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "real_provider": {"const": true}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "profile", "task_id", "attempt_id", "source_sha", "image_digest", "native_final", "events", "usage", "evidence"],
      "properties": {
        "id": {"enum": ["RT01", "RT02", "RT03", "RT04", "RT05", "RT06", "RT07", "RT08", "RT09"]},
        "status": {"const": "PASSED"},
        "profile": {"enum": ["codex_http", "claude_http"]},
        "task_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "native_final": {
          "type": "object",
          "additionalProperties": false,
          "required": ["present", "sha256", "terminal_state"],
          "properties": {
            "present": {"const": true},
            "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "terminal_state": {"type": "string", "minLength": 1}
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first_sequence", "last_sequence", "contiguous"],
          "properties": {
            "first_sequence": {"type": "integer", "minimum": 0},
            "last_sequence": {"type": "integer", "minimum": 0},
            "contiguous": {"const": true}
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "input_tokens", "output_tokens", "total_tokens", "cost_usd"],
          "properties": {
            "complete": {"const": true},
            "input_tokens": {"type": "integer", "minimum": 0},
            "output_tokens": {"type": "integer", "minimum": 0},
            "total_tokens": {"type": "integer", "minimum": 0},
            "cost_usd": {"type": "number", "minimum": 0}
          }
        },
        "evidence": {"type": "object", "minProperties": 1}
      }
    }
  }
}
